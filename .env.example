# ── Phase 0: Platform Core ──────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Phase 1: Qdrant Vector DB & Embeddings ─────────────────────────────────
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_CLUSTER_ENDPOINT=https://your-cluster-id.us-east-2-0.aws.cloud.qdrant.io
QDRANT_COLLECTION_NAME=bkip_docs
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# ── Phase 2: Direct LLM Gateway (Groq) ──────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Phase 5: Portkey Gateway & Multi-Model Resilience ───────────────────────
PORTKEY_API_KEY=your_portkey_api_key_here
PORTKEY_CONFIG_ID=your_portkey_config_id_here
GROQ_FALLBACK_API_KEY=gsk_your_fallback_groq_api_key_here

# ── Phase 5: Deep Observability (Logfire & LangSmith) ────────────────────────
LOGFIRE_TOKEN=pylf_v1_your_logfire_token_here

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_your_langchain_api_key_here
LANGCHAIN_PROJECT=bkip

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_your_langchain_api_key_here
LANGSMITH_PROJECT=bkip

# ── Phase 6: Automated Evaluation (RAGAS Judge) ────────────────────────────
JUDGE_GROQ_API_KEY=gsk_your_judge_groq_api_key_here
